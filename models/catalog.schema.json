{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aura model catalog",
  "description": "Documentation schema. The authoritative validator (with cross-field rules) is models/catalog.ts.",
  "type": "object",
  "required": ["schemaVersion", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedNote": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "hfRepo", "license", "licenseClass", "commercialUse", "parameters", "formats", "sizeBytes", "sha256", "minRamMb", "sourceUrl", "dateChecked", "verified"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["quick-actions", "agent-brain", "embedding", "reranker", "speech-to-text", "ocr-vision", "safety"] },
          "hfRepo": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$" },
          "license": { "type": "string", "minLength": 1 },
          "licenseClass": { "enum": ["permissive", "custom-terms", "non-commercial", "unknown"] },
          "commercialUse": { "enum": ["yes", "no", "unknown"] },
          "parameters": { "type": ["integer", "null"], "minimum": 1 },
          "formats": { "type": "array", "items": { "enum": ["safetensors", "gguf", "onnx", "pytorch-bin", "ggml"] } },
          "sizeBytes": { "type": ["integer", "null"], "minimum": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "minRamMb": { "type": ["integer", "null"], "minimum": 1 },
          "sourceUrl": { "type": "string", "pattern": "^https://huggingface\\.co/" },
          "dateChecked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "verified": { "type": "boolean" },
          "gated": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
