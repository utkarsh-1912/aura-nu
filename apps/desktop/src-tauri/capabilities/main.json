{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window. NO fs/shell/http plugin permissions: vault IO goes only through scoped Rust commands. App-command permission ids (allow-<command>) are generated by build.rs/AppManifest; verify names in gen/schemas.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-capabilities",
    "allow-vault-pick", "allow-vault-open", "allow-vault-current", "allow-vault-close", "allow-vault-read",
    "allow-vault-write", "allow-vault-list", "allow-vault-stat", "allow-vault-rename", "allow-vault-remove",
    "allow-vault-watch-start",
    "allow-quicknote-show", "allow-quicknote-hide", "allow-quicknote-set-shortcut",
    "allow-sidecar-start", "allow-sidecar-stop", "allow-sidecar-status",
    "allow-models-list", "allow-models-download", "allow-models-cancel", "allow-models-verify",
    "allow-models-remove", "allow-models-disk-usage", "allow-models-set-quota",
    "allow-keychain-set", "allow-keychain-get", "allow-keychain-delete",
    "allow-update-check", "allow-update-install"
  ]
}
