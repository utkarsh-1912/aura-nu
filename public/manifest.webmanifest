{
  "name": "Aura Next",
  "short_name": "Aura",
  "description": "Offline-first enterprise notes workspace with capture, scanning and AI.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#fafafc",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "business"],
  "icons": [
    { "src": "/logo.png", "sizes": "any", "type": "image/png", "purpose": "any" },
    { "src": "/logo.png", "sizes": "any", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New note", "short_name": "New", "url": "/?action=new-note", "icons": [{ "src": "/logo.png", "sizes": "any", "type": "image/png" }] },
    { "name": "Quick note", "short_name": "Quick", "url": "/?action=quick-note", "icons": [{ "src": "/logo.png", "sizes": "any", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "audio/*", "application/pdf", "text/plain", "text/markdown"] }
      ]
    }
  }
}
