# Users configure this via the Secrets panel in the Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
MONGODB_URI="MY_MONGODB_URI"
# Server auth: Firebase project used to verify ID tokens (required in production)
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"

# Provider-agnostic AI API (any OpenAI-compatible server: vLLM, Ollama, LM Studio, llama.cpp, HF endpoints)
AURA_LLM_BASE_URL=""
AURA_LLM_API_KEY=""
AURA_LLM_MODEL=""
AURA_EMBED_MODEL=""
# cloud-allowed | self-host-only | local-only
AURA_AI_POLICY="cloud-allowed"

# Collaboration + sharing (api/platform.ts). See docs/handoff/wiring-server.md
# HMAC secret for signed share links, >= 16 chars. Unset => link endpoints answer 503.
SHARE_LINK_SECRET=""
# Always-on Node host only (WebSockets). Comma-separated exact Origins allowed to open /collab sockets.
COLLAB_ALLOWED_ORIGINS=""
COLLAB_DATA_DIR=".collab-data"
# File-backend root for grants, SCIM, AI policy, usage (Mongo is used instead when connected)
AURA_DATA_DIR=".aura-data"
# Optional public base URL for SCIM meta.location, e.g. https://api.example.com/scim/v2
SCIM_BASE_URL=""
